#. Description of the plugin
#: ai-translate.php
msgid ""
"AI based translation plugin. Adding 35 languages in a few clicks. Fast "
"caching, SEO-friendly, and cost-effective."
msgstr ""
"Plugin di traduzione basato sull'IA. Aggiungi 35 lingue in pochi clic. Cache "
"veloce, SEO-friendly ed economico."

