msgid "Glossary (forced term translations)"
msgstr "Glossary (forced term translations)"

#: includes/admin-page.php:1900
msgid ""
"One term per line: source term = lang: translation, lang: translation. The "
"source term is matched against your default language; the given translation "
"is then enforced in the translation prompt for that target language. "
"Example: Bike = de: Fahrrad, nl: Fiets. Clear the page cache after changing "
"the glossary."
msgstr ""
"One term per line: source term = lang: translation, lang: translation. The "
"source term is matched against your default language; the given translation "
"is then enforced in the translation prompt for that target language. "
